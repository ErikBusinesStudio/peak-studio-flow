      {
        "name": "add_pagamento",
        "title": "Registra pagamento",
        "description": "Registra un pagamento di un cliente (importo lordo, trattenuta % opzionale; il netto è calcolato dal database).",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "cliente_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "descrizione": {
              "type": "string",
              "minLength": 1
            },
            "importo_lordo": {
              "type": "number"
            },
            "trattenuta_pct": {
              "default": 0,
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "periodo": {
              "default": "dopo",
              "type": "string",
              "enum": [
                "prima",
                "dopo"
              ]
            },
            "stato": {
              "default": "da_incassare",
              "type": "string",
              "enum": [
                "incassato",
                "da_incassare"
              ]
            },
            "data": {
              "description": "YYYY-MM-DD",
              "type": "string"
            }
          },
          "required": [
            "cliente_id",
            "descrizione",
            "importo_lordo"
          ]
        },
        "outputSchema": null
      },
